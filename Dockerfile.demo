# jeeflow-go demo Docker 镜像
# 构建阶段
FROM golang:1.25-alpine AS builder
WORKDIR /build
# 国内网络环境使用 goproxy.cn 加速依赖下载
ENV GOPROXY=https://goproxy.cn,direct
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /go-demo ./cmd/demo

# 运行阶段
FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata
COPY --from=builder /go-demo /go-demo
# 本仓 flows/ 副本（flowsutil.Dir() 从 cwd=/app 向上命中；用户单仓即可构建）
WORKDIR /app
COPY flows /app/flows
EXPOSE 8081
CMD ["/go-demo"]